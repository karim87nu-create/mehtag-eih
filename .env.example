APP_ENV=production
APP_BASE_URL=https://YOUR-DOMAIN
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Full conversational mode. Without this key the app runs in an explicitly
# labelled, safe local fallback mode.
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_BASE_URL=https://api.openai.com/v1

# Global-by-default customer context; Egypt is the first operating locale.
DEFAULT_LOCALE=ar-EG

# Optional real supplier channel: Meta WhatsApp Cloud API. The approved template
# body must accept: request id, item, area, reply URL (in that order).
MAAK_WHATSAPP_PHONE_NUMBER_ID=
MAAK_WHATSAPP_ACCESS_TOKEN=
MAAK_WHATSAPP_APP_SECRET=
MAAK_WHATSAPP_VERIFY_TOKEN=
MAAK_WHATSAPP_TEMPLATE=
MAAK_WHATSAPP_TEMPLATE_LANGUAGE=ar
MAAK_WHATSAPP_GRAPH_VERSION=v23.0
